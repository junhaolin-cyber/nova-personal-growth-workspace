# 后续接入 AI 能力时使用
# OPENAI_API_KEY=

# NewsAPI（仅开发测试阶段可选；正式环境请先确认服务条款）
# NEWS_API_KEY=

# 高德地图 Web 服务 API Key（只放服务端环境变量，不要使用 NEXT_PUBLIC_ 前缀）
# AMAP_WEB_SERVICE_KEY=
# 如果在高德控制台启用了数字签名，再配置安全密钥
# AMAP_WEB_SERVICE_SECURITY_KEY=

# TMDB API Read Access Token（影视数据服务端调用，不要使用 NEXT_PUBLIC_ 前缀）
# TMDB_API_READ_ACCESS_TOKEN=

# 后续接入能力的开关，当前保持关闭
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_CLOUD_DATABASE_ENABLED=false
NEXT_PUBLIC_SYNC_ENABLED=false
NEXT_PUBLIC_PWA_ENABLED=false

# 后续部署时使用
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# DATABASE_URL=

# Supabase 基础设施（Project URL 和 Publishable Key 可用于浏览器；不要填写 Secret/Service Role Key）
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
